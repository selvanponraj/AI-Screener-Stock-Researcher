GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
STOCK_RESEARCHER_PORT=8765

# Local RAG settings
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Leave unset normally. Set to 0 on a fresh machine if you need to force-download
# the embedding model, or 1 if you want strictly offline model loading.
# EMBEDDING_LOCAL_FILES_ONLY=1
RAG_CHUNK_SIZE=2500
RAG_CHUNK_OVERLAP=350

# External web search for news and industry nodes
DDG_RESULTS_PER_QUERY=5
DDG_SEARCH_TIMEOUT_SECONDS=15
