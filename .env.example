LITELLM_BASE_URL=http://132.145.30.2:4000/v1
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=gpt-5.6-luna
STOCK_RESEARCHER_PORT=8765
SCREENER_BROWSER_CHANNEL=chrome
SCREENER_PROFILE_DIR=.browser/screener-profile-chrome
SCREENER_EMAIL=your-screener-email
SCREENER_PASSWORD=your-screener-password

# Screener screens to crawl. Use comma-separated URLs; replace these with your
# own screen links if you use different Screener screens.
SCREENER_SCREEN_URLS=https://www.screener.in/screens/2122337/market-cap-to-profit/,https://www.screener.in/screens/2242309/return-less-than-profit-growth/,https://www.screener.in/screens/2402442/dpr/

# Local RAG settings
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# Leave unset normally. Set to 0 on a fresh machine if you need to force-download
# the embedding model, or 1 if you want strictly offline model loading.
# EMBEDDING_LOCAL_FILES_ONLY=1
RAG_CHUNK_SIZE=2500
RAG_CHUNK_OVERLAP=350
RAG_MIN_SIMILARITY_SCORE=0.30

# External web search for news and industry nodes
DDG_RESULTS_PER_QUERY=5
DDG_SEARCH_TIMEOUT_SECONDS=15

# Screener screens for risky bets - cwip
RISKY_BET_SCREENER_URL=https://www.screener.in/screens/3899369/multi-bagger-cwip/

